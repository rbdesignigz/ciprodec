rules_version = '2';
// Reglas de seguridad de CIPRODEC para Cloud Firestore.
// Copiar este archivo completo en Consola Firebase > Firestore Database > Reglas > Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    function email() {
      return request.auth != null && request.auth.token.email != null
        ? request.auth.token.email.lower() : '';
    }
    function verificado() {
      return request.auth != null && (request.auth.token.email_verified == true
        || request.auth.token.firebase.sign_in_provider == 'google.com');
    }
    function superadmin() {
      return verificado() && email() in ['gerenciaciprodec@gmail.com', 'pablo.da.ber@gmail.com'];
    }
    function perfil() {
      return get(/databases/$(database)/documents/usuarios/$(email())).data;
    }
    function tieneRol(roles) {
      return superadmin() || (verificado()
        && exists(/databases/$(database)/documents/usuarios/$(email()))
        && perfil().activo == true
        && perfil().rol in roles);
    }
    function esCliente(data) {
      return verificado() && email() in data.clientes;
    }

    // Contenido público: cualquiera lo lee, solo el personal autorizado lo modifica.
    match /noticias/{id}    { allow read: if true; allow write: if tieneRol(['admin', 'editor']); }
    match /obras/{id}       { allow read: if true; allow write: if tieneRol(['admin', 'editor']); }
    match /ediciones/{id}   { allow read: if true; allow write: if tieneRol(['admin', 'editor']); }
    match /fuentes/{id}     { allow read: if true; allow write: if tieneRol(['admin', 'editor']); }
    match /propiedades/{id} { allow read: if true; allow write: if tieneRol(['admin', 'inmobiliaria']); }
    match /ajustes/{id}     { allow read: if true; allow write: if tieneRol(['admin']); }
    match /fotos/{id}       { allow read: if true; allow write: if tieneRol(['admin', 'editor', 'inmobiliaria']); }

    // Chat de saludos de CIPRODEC Radio: cualquiera lee y manda un saludo (con límites de tamaño);
    // las respuestas de la radio las escribe el respondedor (con credencial de servidor) o el personal.
    match /radioChat/{id} {
      allow read: if true;
      allow create: if (request.resource.data.keys().hasOnly(['nombre', 'ciudad', 'texto', 'tipo', 'ts'])
          && request.resource.data.tipo == 'oyente'
          && request.resource.data.nombre is string && request.resource.data.nombre.size() > 0 && request.resource.data.nombre.size() <= 30
          && request.resource.data.ciudad is string && request.resource.data.ciudad.size() <= 30
          && request.resource.data.texto is string && request.resource.data.texto.size() > 0 && request.resource.data.texto.size() <= 200
          && request.resource.data.ts == request.time)
        || tieneRol(['admin', 'editor']);
      allow update, delete: if tieneRol(['admin', 'editor']);
    }

    // Usuarios autorizados (el id del documento es el email en minúsculas).
    match /usuarios/{mail} {
      allow read: if mail == email() || tieneRol(['admin']);
      allow write: if tieneRol(['admin']);
    }

    // Área de clientes: cada obra lista los emails de sus clientes en el campo "clientes".
    match /obrasClientes/{id} {
      allow read: if tieneRol(['admin', 'editor']) || esCliente(resource.data);
      allow write: if tieneRol(['admin', 'editor']);
    }
    match /fotosPrivadas/{id} {
      allow read: if tieneRol(['admin', 'editor']) || esCliente(resource.data);
      allow write: if tieneRol(['admin', 'editor']);
    }

    // Portal de constructores (constructor.html): se entra con un código, sin cuenta.
    // El código es el id del documento de la constructora y solo se puede leer conociéndolo (get, no list).
    // Cada presupuesto tiene un id aleatorio largo que solo figura en su constructora.
    // Quien tiene el código puede cambiar precios, cantidades y ajustes, pero no crear, borrar ni moverlo de constructora.
    match /constructores/{codigo} {
      allow get: if true;
      allow list, create, delete: if tieneRol(['admin', 'editor']);
      // La constructora solo puede cambiar sus datos para imprimir (nombre, RUC, logo, etc.).
      allow update: if tieneRol(['admin', 'editor'])
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['perfil', 'actualizado'])
            && request.resource.data.perfil is map);
    }
    match /presupuestos/{id} {
      allow get: if true;
      allow list, create, delete: if tieneRol(['admin', 'editor']);
      allow update: if tieneRol(['admin', 'editor'])
        || (request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['items', 'parametros', 'proveedores', 'cierre', 'clienteDatos', 'actualizado', 'actualizadoPor'])
            && request.resource.data.items is list
            && request.resource.data.items.size() <= 2000);
    }
  }
}
